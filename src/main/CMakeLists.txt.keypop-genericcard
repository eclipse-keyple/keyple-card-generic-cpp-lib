# FetchContent added in CMake 3.11, downloads during the configure step
# FetchContent_MakeAvailable was added in CMake 3.14; simpler usage
INCLUDE(FetchContent)

IF(NOT EXISTS "${CMAKE_BINARY_DIR}/_deps/keypopgenericcardcppapi-src")

    MESSAGE("-- > Fetching keypop generic card from keyple card generic")

    # Checkout Keypop Generic Card Cpp Api dependency
    FetchContent_Declare(

        KeypopGenericCardCppApi

        DOWNLOAD_EXTRACT_TIMESTAMP true
        GIT_REPOSITORY https://github.com/eclipse-keypop/keypop-genericcard-cpp-api
        GIT_TAG develop-1.0.0
    )

ELSE()

    FetchContent_Declare(

        KeypopGenericCardCppApi

        SOURCE_DIR ${CMAKE_BINARY_DIR}/_deps/keypopgenericcardcppapi-src
    )

ENDIF()

FetchContent_MakeAvailable(KeypopGenericCardCppApi)
